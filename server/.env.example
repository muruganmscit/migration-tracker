# When running via `docker compose up` (recommended), docker-compose.yml overrides DATABASE_URL
# to the in-network service. If you run `npm run dev` directly on the host, also use SMTP_HOST=localhost.
DATABASE_URL="postgresql://portal:portal@localhost:5432/harness_migration_portal"
PORT=4000

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Harness Migration Portal <migration-portal@yourcompany.com>"

APP_BASE_URL=http://localhost:5173

# To send through Gmail instead of the local Mailpit catcher:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your.address@gmail.com
#   SMTP_PASS=16-character app password, no spaces (myaccount.google.com/apppasswords)
#   EMAIL_FROM="Harness Migration Portal <your.address@gmail.com>"

# When set, ALL email goes to this address instead of the real recipients.
EMAIL_REDIRECT_TO=
