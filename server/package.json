{
  "name": "harness-migration-portal-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "seed": "ts-node src/seed.ts",
    "email:test": "ts-node --transpile-only src/scripts/testEmail.ts",
    "test": "TS_NODE_TRANSPILE_ONLY=1 node --test --require ts-node/register src/lib/*.test.ts",
    "test:api": "TS_NODE_TRANSPILE_ONLY=1 node --test --test-concurrency=1 --require ts-node/register src/lib/*.test.ts src/routes/*.test.ts",
    "test:coverage": "c8 npm run test:api && sed -i.bak 's#^SF:/app/#SF:#' coverage/lcov.info && rm -f coverage/lcov.info.bak",
    "seed:scenarios": "ts-node --transpile-only src/scripts/seedScenarios.ts --reset"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.15",
    "pdfkit": "^0.15.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "@types/pdfkit": "^0.13.4",
    "@types/supertest": "^7.2.1",
    "c8": "^12.0.0",
    "prisma": "^5.20.0",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
