{
  "all": true,
  "src": ["src"],
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/test/**", "src/scripts/**", "src/seed.ts", "src/index.ts"],
  "extension": [".ts"],
  "reporter": ["lcov", "text-summary", "text"],
